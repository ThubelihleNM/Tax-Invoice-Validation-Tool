# ============================================================
# Smart Tax Invoice Validation Tool - Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your real .env to version control!
# ============================================================

# Application Settings
PROJECT_NAME="Smart Tax Invoice Validation API"
JWT_SECRET_KEY="CHANGE-ME-use-a-long-random-secret-key-in-production"
SECRET_KEY="CHANGE-ME-use-a-long-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================
# Database Configuration
# ============================================================
# OPTION 1: SQLite (RECOMMENDED for local development - no server needed)
# The database file lives at backend/invoice_db.db
DATABASE_URL="sqlite:///./invoice_db.db"

# OPTION 2: MySQL / MariaDB (for production or if you have MySQL running)
# Uncomment the line below and comment out the SQLite line above:
# DATABASE_URL="mysql+pymysql://invoice_user:invoice_password@127.0.0.1:3306/tax_invoice_db?charset=utf8mb4"

# ============================================================
# Storage & Uploads
# ============================================================
UPLOAD_DIR="./uploads"

# ============================================================
# CORS Configuration
# Frontend must be listed here so the browser allows API calls
# ============================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL="http://localhost:3000"

# ============================================================
# SMTP Email Settings (optional - leave blank to disable emails)
# ============================================================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@taxaudit.com"

# ============================================================
# Tesseract OCR (leave blank for auto-detection)
# ============================================================
TESSERACT_CMD=""

# ============================================================
# HOW TO START THE APPLICATION
# ============================================================
# 1. Double-click run_all.bat  (starts both backend & frontend)
#    OR start them individually:
#
# Backend only:
#   cd backend
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload
#
# Frontend only:
#   cd frontend
#   npm run dev
#
# URLs:
#   React App:    http://localhost:3000
#   API Backend:  http://127.0.0.1:8000
#   Swagger Docs: http://127.0.0.1:8000/docs
#   Health Check: http://127.0.0.1:8000/health
# ============================================================
