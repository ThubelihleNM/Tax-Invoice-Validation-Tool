# Application Settings
PROJECT_NAME="Smart Tax Invoice Validation API"
SECRET_KEY="production-super-secret-jwt-key-replace-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; configure MySQL in production)
# SQLite (development default):
DATABASE_URL="sqlite:///./invoice_db.db"

# MySQL Production Connection:
# DATABASE_URL="mysql+pymysql://invoice_user:invoice_password@localhost:3306/tax_invoice_db"

# Storage & Uploads
UPLOAD_DIR="./uploads"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8000"]

# Tesseract OCR Executable (leave blank for auto-detection on Windows/Linux)
TESSERACT_CMD=""
