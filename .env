# Application Settings
PROJECT_NAME="Smart Tax Invoice Validation API"
JWT_SECRET_KEY="production-super-secret-jwt-key-taxaudit-2026"
SECRET_KEY="production-super-secret-jwt-key-taxaudit-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (Defaults to SQLite; configure MySQL in production)
DATABASE_URL="sqlite:///./invoice_db.db"

# Storage & Uploads
UPLOAD_DIR="./uploads"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL="http://localhost:8000"

# SMTP Settings (Optional, configure for production email delivery)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@taxaudit.com"

# Tesseract OCR Executable (leave blank for auto-detection)
TESSERACT_CMD=""
